{
  "name": "valoryx",
  "version": "1.0.7",
  "description": "Professional Billing and Inventory Management System",
  "author": {
    "name": "RYX Tech",
    "email": "ryxdevsolution@gmail.com"
  },
  "homepage": "https://valoryx.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/ryxdevsolution-stack/Valoryx.git"
  },
  "license": "Proprietary",
  "main": "electron/main.js",
  "scripts": {
    "dev:backend": "cd backend && python app.py",
    "dev:frontend": "cd frontend-react && npm run dev",
    "build:frontend": "cd frontend-react && npm run build",
    "build": "npm run build:frontend",
    "electron:dev": "electron . --dev",
    "electron:start": "npm run build:frontend && electron .",
    "electron:build": "cd frontend-react && npm run build:electron && cd .. && electron-builder",
    "electron:build:win": "cd frontend-react && npm run build:electron && cd .. && electron-builder --win",
    "electron:pack": "electron-builder --dir",
    "build:icon": "electron-icon-builder --input=./build/icon.png --output=./electron/resources/ && cp ./electron/resources/icons/win/icon.ico ./electron/resources/icon.ico",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "electron-icon-builder": "^2.0.1"
  },
  "build": {
    "appId": "com.ryx.valoryx",
    "productName": "Valoryx",
    "copyright": "Copyright © 2024 RYX Tech",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!__pycache__/**",
          "!*.pyc",
          "!venv/**"
        ]
      },
      {
        "from": "frontend-react/dist",
        "to": "frontend-react/dist",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/resources/icon.ico",
      "artifactName": "Valoryx-Setup-${version}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "installerIcon": "electron/resources/icon.ico",
      "uninstallerIcon": "electron/resources/icon.ico",
      "installerHeaderIcon": "electron/resources/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Valoryx"
    },
    "portable": {
      "artifactName": "Valoryx-Portable-${version}.${ext}"
    }
  }
}
