# ============================================================================
# RYX Billing - Backend Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values
# NEVER commit the actual .env file to version control
# ============================================================================

# ===========================================
# ENVIRONMENT
# ===========================================
# Options: development, production, testing
FLASK_ENV=development
ENVIRONMENT=development

# ===========================================
# SECURITY (CRITICAL - Change in production!)
# ===========================================
# Generate strong secrets using: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-in-production-use-strong-random-value
SECRET_KEY=change-this-in-production-use-another-strong-value

# Token expiration in hours
JWT_EXPIRY_HOURS=24

# Desktop Google login bridge (optional — desktop OAuth disabled if unset).
# Shared HMAC secret that signs/verifies the short-lived assertion bridging a
# cloud Google login into the offline desktop app. MUST be the SAME value in:
#   1. the cloud server .env (this file, on the VPS) — the cloud SIGNS the assertion
#   2. the installer's env.local (via the BACKEND_ENV_LOCAL_B64 CI secret) — the
#      desktop backend VERIFIES it
# A mismatch makes every desktop Google login fail with 401. Never expose it in
# the frontend/JS bundle. Generate: python -c "import secrets; print(secrets.token_hex(32))"
DESKTOP_OAUTH_SECRET=change-this-same-value-in-cloud-env-and-installer-env-local

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# For PostgreSQL (Supabase or self-hosted)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# For local SQLite (development only)
# DATABASE_URL=sqlite:///ryx_billing.db

# ===========================================
# SUPABASE CONFIGURATION (Optional)
# ===========================================
# Get these from your Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# ===========================================
# CORS CONFIGURATION
# ===========================================
# Comma-separated list of allowed origins
# Use * for development only, be specific in production
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# ===========================================
# FRONTEND URL
# ===========================================
# Base URL used in invite/reset/verify email links
# Development: http://localhost:3002
# Production:  https://valoryx.ryxtech.in
FRONTEND_URL=http://localhost:3002

# ===========================================
# LOGGING
# ===========================================
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ===========================================
# APPLICATION
# ===========================================
APP_NAME=RYX Billing
APP_VERSION=1.0.0

# Server port (optional, defaults to 5000)
PORT=5000

# Enable debug mode (set to False in production)
DEBUG=True

# ===========================================
# SMTP / EMAIL CONFIGURATION
# ===========================================
# Used for invite emails, password resets, audit reports, etc.
# Leave blank to disable email sending (app will log a warning and skip)

# SMTP server hostname (e.g. smtp.gmail.com)
SMTP_HOST=smtp.gmail.com

# SMTP port — 587 for STARTTLS (recommended), 465 for SSL
SMTP_PORT=587

# Login credentials for your SMTP account
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=

# The "From" address shown to recipients (defaults to SMTP_USER if blank)
SMTP_FROM_EMAIL=your-email@gmail.com

# Display name shown in the From field
SMTP_FROM_NAME=Valoryx

# ── Reverse proxy / network trust (security) ─────────────────────────────────
# Number of reverse-proxy hops in front of the app (nginx, load balancer...).
# ProxyFix uses this to resolve the real client IP from X-Forwarded-For for
# login rate limiting and audit logs.
#   1 = behind one proxy (production default)
#   0 = app exposed directly — X-Forwarded-For is IGNORED (set this if there
#       is no proxy, otherwise clients can spoof their IP)
TRUSTED_PROXY_COUNT=1

# Interface the dev server binds to (gunicorn ignores this; the Electron
# desktop app forces 127.0.0.1)
BIND_HOST=0.0.0.0
