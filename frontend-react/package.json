{
  "name": "valoryx-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node -e \"const fs=require('fs');const path=require('path');const src='dist';const dest='../backend/static/frontend';fs.rmSync(dest,{recursive:true,force:true});fs.cpSync(src,dest,{recursive:true});console.log('Copied to backend/static/frontend')\"",
    "build:electron": "cross-env ELECTRON_BUILD=true vite build --mode electron && node -e \"const fs=require('fs');const src='dist';const dest='../backend/static/frontend';fs.rmSync(dest,{recursive:true,force:true});fs.cpSync(src,dest,{recursive:true});console.log('Copied to backend/static/frontend')\"",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@tanstack/react-virtual": "^3.13.23",
    "@types/three": "^0.183.1",
    "axios": "1.6.2",
    "barcode-detector": "^3.1.1",
    "date-fns": "3.0.6",
    "framer-motion": "10.16.16",
    "gsap": "^3.14.2",
    "highcharts": "^12.4.0",
    "highcharts-react-official": "^3.2.3",
    "lucide-react": "^0.548.0",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^6.28.0",
    "react-to-print": "^3.2.0",
    "tesseract.js": "^7.0.0",
    "three": "^0.181.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "20.10.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "18.2.46",
    "@types/react-dom": "18.2.18",
    "@types/web-bluetooth": "^0.0.21",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.22",
    "cross-env": "^10.1.0",
    "eslint": "8.56.0",
    "jsdom": "^25.0.1",
    "msw": "^2.12.12",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "5.3.3",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^3.2.4"
  }
}
